{
  "manifest_version": 3,
  "name": "Barn Election Feed",
  "version": "1.1",
  "description": "Sends the NYT and CNN live election posts to the Posters app on this Mac, for display on the barn screens.",
  "host_permissions": [
    "https://www.nytimes.com/*",
    "http://localhost:5055/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.nytimes.com/live/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.cnn.com/*/live-news/*"
      ],
      "js": [
        "content_cnn.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
